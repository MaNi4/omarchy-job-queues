#!/bin/sh
# Every test of the plugin. Nothing here connects anywhere or touches the
# real config; see helper.py.
cd -- "$(dirname -- "$0")" || exit 1
status=0
python3 -B -m unittest discover -s . -p 'test_*.py' "$@" || status=1
if command -v ruby >/dev/null 2>&1; then
  ruby remote_test.rb || status=1
else
  echo "ruby not found: remote_test.rb was not run" >&2
  status=1
fi
exit $status
